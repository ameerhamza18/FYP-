<?xml version="1.0" encoding="utf-8"?>
<!--
  TrustLayer DEBUG-ONLY network policy.

  Merged only on debug/emulator builds so developers can reach a local backend
  running on 10.0.2.2, localhost, or any LAN Wi-Fi host without TLS.
  Release builds use src/main/res/xml/network_security_config.xml (HTTPS only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
