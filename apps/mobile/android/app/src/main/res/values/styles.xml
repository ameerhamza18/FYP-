<?xml version="1.0" encoding="utf-8"?>
<!--
  Window themes. The app is permanently dark (themeMode: ThemeMode.dark in
  main.dart), so the launch window is dark too — a Theme.Light parent would
  flash white on every cold start.
-->
<resources>
    <!-- Applied while the process is starting, until Flutter draws frame 1. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/tl_background</item>
        <item name="android:navigationBarColor">@color/tl_background</item>
    </style>

    <!-- Applied once the process is up; also paints behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/tl_background</item>
        <item name="android:statusBarColor">@color/tl_background</item>
        <item name="android:navigationBarColor">@color/tl_background</item>
    </style>
</resources>
