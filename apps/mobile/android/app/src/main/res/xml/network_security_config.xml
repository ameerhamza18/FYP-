<?xml version="1.0" encoding="utf-8"?>
<!--
  TrustLayer production network policy.

  Cleartext HTTP is DENIED everywhere in production/release builds so a user
  on a hostile Wi-Fi network cannot be silently downgraded to plain HTTP and
  have their JWT or scanned message intercepted.

  Local development cleartext exceptions (emulator 10.0.2.2, loopback) live in
  src/debug/res/xml/network_security_config.xml and are never merged into release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
