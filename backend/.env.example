# =============================================================
# TrustLayer Backend - Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env to version control.
# =============================================================

# --- Core ---
APP_NAME=TrustLayer API
APP_ENV=development          # development | staging | production
DEBUG=true

# --- Secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (SQLite for dev, PostgreSQL for production) ---
DATABASE_URL=sqlite:///./trustlayer.db
# DATABASE_URL=postgresql://trustlayer:trustlayer@localhost:5432/trustlayer

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Rate limiting (requests per window) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=8

# --- LLM explanation engine (optional; template fallback used when unset) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# --- Admin bootstrap (created automatically on first startup) ---
ADMIN_EMAIL=admin@trustlayer.com
ADMIN_PASSWORD=Admin@12345

# --- Campaign webhook alert (optional) ---
# Fires a JSON POST to this URL when a coordinated campaign is detected.
# Compatible with Slack Incoming Webhooks, Discord, or any SIEM HTTP endpoint.
# Leave blank to disable.
CAMPAIGN_WEBHOOK_URL=

