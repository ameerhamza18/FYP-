# =============================================================
# TrustLayer Docker stack — environment template
#
#   copy infrastructure/docker/.env.example infrastructure/docker/.env
#
# Then rotate EVERY value below before deploying anywhere real.
# `.env` is gitignored; never commit a filled-in copy.
# =============================================================

# --- Required: the stack refuses to start without these ---------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-64-char-random-string

# Bootstrap admin account, created on the first API startup.
# Minimum 12 characters and not a known default, or the API refuses
# to boot with APP_ENV=production.
ADMIN_EMAIL=admin@trustlayer.com
ADMIN_PASSWORD=replace-me-with-a-strong-unique-passphrase

# Password for the bundled PostgreSQL service.
DB_PASSWORD=replace-me-with-a-strong-db-password

# 44-character base64 Fernet encryption key for at-rest snippet encryption.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-me-with-a-44-char-base64-fernet-key

# --- Optional ---------------------------------------------------------
# Browser origins allowed to call the API (comma separated, no wildcards).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Public URL the browser uses to reach the API. Inlined into the Next.js
# client bundle at BUILD time, so changing it requires a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:8001/api

# Keep the sliding-window limiter on in every environment.
RATE_LIMIT_ENABLED=true